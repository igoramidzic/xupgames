import { v } from 'convex/values';
import { mutation, query } from './_generated/server';

const phaseValidator = v.union(v.literal('lobby'), v.literal('active'), v.literal('complete'));

export const initialize = mutation({
  args: { roomId: v.string() },
  returns: v.null(),
  handler: async (ctx, args) => {
    const existing = await ctx.db
      .query('gameStates')
      .withIndex('by_roomId', (index) => index.eq('roomId', args.roomId))
      .unique();
    if (existing === null) {
      await ctx.db.insert('gameStates', {
        roomId: args.roomId,
        phase: 'lobby',
        updatedAt: Date.now(),
      });
    }
    return null;
  },
});

export const getState = query({
  args: { roomId: v.string() },
  returns: v.union(v.null(), v.object({ phase: phaseValidator, updatedAt: v.number() })),
  handler: async (ctx, args) => {
    const state = await ctx.db
      .query('gameStates')
      .withIndex('by_roomId', (index) => index.eq('roomId', args.roomId))
      .unique();
    return state === null ? null : { phase: state.phase, updatedAt: state.updatedAt };
  },
});
