import { defineSchema, defineTable } from 'convex/server';
import { v } from 'convex/values';

export default defineSchema({
  gameStates: defineTable({
    // Parent-app Convex IDs cross component boundaries as strings.
    roomId: v.string(),
    phase: v.union(v.literal('lobby'), v.literal('active'), v.literal('complete')),
    updatedAt: v.number(),
  }).index('by_roomId', ['roomId']),
});
